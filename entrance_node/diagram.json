    [ "esp:39", "btn_tamper:1", "green", [] ],
    [ "btn_tamper:2", "esp:GND.1", "black", [] ],
    [ "esp:39", "r_tamper:1", "blue", [] ],
    [ "r_tamper:2", "esp:3V3", "red", [] ],

    [ "esp:35", "btn_passage:1", "green", [] ],
    [ "btn_passage:2", "esp:3V3", "red", [] ],
    [ "esp:35", "r_passage:1", "blue", [] ],
    [ "r_passage:2", "esp:GND.1", "black", [] ]
