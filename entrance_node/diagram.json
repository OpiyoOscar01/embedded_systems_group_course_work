    [ "servo_exit:V+", "esp:3V3", "red", [] ],
    [ "servo_exit:GND", "esp:GND.1", "black", [] ],

    [ "esp:4", "buzzer:2", "orange", [] ],
    [ "buzzer:1", "esp:GND.1", "black", [] ],

    [ "esp:34", "btn_emergency:1", "green", [] ],
    [ "btn_emergency:2", "esp:GND.1", "black", [] ],
    [ "esp:34", "r_emergency:1", "blue", [] ],
